<%
// ==========================================================================
// STRICT SORTING FIX: Ensure Seasons & Episodes are always in numerical order
// ==========================================================================
if (anime && anime.seasons) {
    anime.seasons.sort((a, b) => a.seasonNumber - b.seasonNumber);
    anime.seasons.forEach(season => {
        if (season.episodes) {
            season.episodes.sort((a, b) => a.episodeNumber - b.episodeNumber);
        }
    });
}
%>
<%- include('partials/header') %>

<style>
    /* ==========================================================================
       Global Variables & Base Setup
       ========================================================================== */
    :root {
        --bg-deep: #0b0e11;
        --card-navy: #151b23;
        --accent-blue: #3b82f6;
        --accent-cyan: #22d3ee;
        --accent-yellow: #facc15;
        --accent-red: #ef4444;
        --glass-border: rgba(255, 255, 255, 0.05);
    }

    * { box-sizing: border-box; }

    .container { max-width: 100%; width: 100%; }
    .icon-svg { width: 1em; height: 1em; fill: currentColor; flex-shrink: 0; }

    /* Hide scrollbar for horizontal tabs */
    .hide-scrollbar::-webkit-scrollbar { display: none; }
    .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

    /* Keyframe for smooth episode tab switching & load more */
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* ==========================================================================
       Cards & Layout Components
       ========================================================================== */
    .glass-card {
        background: rgba(21, 27, 35, 0.6);
        backdrop-filter: blur(12px);
        border: 1px solid var(--glass-border);
        border-radius: 1.5rem;
        width: 100%;
    }

    /* Episode Card - Responsive Grid */
    .episode-card {
        background: #0f1219;
        border: 1px solid rgba(255, 255, 255, 0.05);
        transition: all 0.3s ease;
        border-radius: 0.75rem;
        overflow: hidden;
        width: 100%;
        display: flex;
        flex-direction: column;
    }

    /* FIXED: Ensures custom display:flex doesn't override tailwind's hidden class */
    .episode-card.hidden {
        display: none !important;
    }

    .episode-card:hover {
        border-color: rgba(34, 211, 238, 0.5); 
        box-shadow: 0 10px 30px -10px rgba(34, 211, 238, 0.2);
        transform: translateY(-4px);
    }

    .ep-image-container { position: relative; aspect-ratio: 16/9; overflow: hidden; border-bottom: 1px solid rgba(255,255,255,0.05); }
    .ep-image-container img {
        width: 100%; height: 100%; object-fit: cover;
        transition: transform 0.6s ease; filter: brightness(0.85);
    }
    .episode-card:hover .ep-image-container img { transform: scale(1.05); filter: brightness(1); }

    /* Top right mini play icon */
    .mini-play-icon {
        position: absolute;
        top: 6px;
        right: 6px;
        background: rgba(0, 0, 0, 0.6);
        width: 24px;
        height: 24px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0.8;
        transition: all 0.3s ease;
        backdrop-filter: blur(4px);
    }
    .episode-card:hover .mini-play-icon { opacity: 1; transform: scale(1.1); background: rgba(0,0,0,0.8); }

    /* Bottom right circular play button */
    .card-play-btn {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: 2px solid var(--accent-blue);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        flex-shrink: 0;
    }
    .episode-card:hover .card-play-btn {
        background: var(--accent-blue);
        box-shadow: 0 0 15px rgba(59, 130, 246, 0.5);
    }
    .card-play-btn i { color: var(--accent-blue); font-size: 12px; margin-left: 2px; transition: color 0.3s; }
    .episode-card:hover .card-play-btn i { color: white; }


    /* ==========================================================================
       Video Player & Controls
       ========================================================================== */
    #player-container video, #player-container iframe { width: 100%; height: 100%; border-radius: 8px; border: none; }

    .player-control-btn {
        background: rgba(59, 130, 246, 0.1); border: 1px solid rgba(59, 130, 246, 0.2);
        color: #60a5fa; padding: 10px 16px; border-radius: 8px; font-weight: 900;
        font-size: 11px; text-transform: uppercase; letter-spacing: 1px;
        transition: all 0.2s; display: flex; align-items: center; justify-content: center; gap: 6px; cursor: pointer; white-space: nowrap;
    }
    .player-control-btn:hover:not(:disabled) {
        background: rgba(59, 130, 246, 0.25); border-color: rgba(59, 130, 246, 0.4);
    }
    .player-control-btn:disabled { opacity: 0.3; cursor: not-allowed; background: rgba(255, 255, 255, 0.05); border-color: rgba(255, 255, 255, 0.1); color: #6b7280; }
    
    .player-control-btn.season-display { background: rgba(250, 204, 21, 0.1); border-color: rgba(250, 204, 21, 0.2); color: #facc15; pointer-events: none; }

    .play-movie-btn {
        background: linear-gradient(135deg, #ef4444, #dc2626); color: #ffffff;
        padding: 1rem 2rem; border-radius: 1rem; font-weight: 900; font-size: 14px;
        text-transform: uppercase; letter-spacing: 1px; transition: all 0.3s;
        display: inline-flex; align-items: center; gap: 10px; cursor: pointer;
        border: none; box-shadow: 0 10px 30px rgba(239, 68, 68, 0.4);
    }
    .play-movie-btn:hover { transform: translateY(-3px); box-shadow: 0 15px 40px rgba(239, 68, 68, 0.6); }

    /* Report Button */
    .report-btn {
        background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2); color: #fca5a5;
        padding: 10px 16px; border-radius: 8px; font-weight: 800; font-size: 11px; text-transform: uppercase;
        letter-spacing: 0.5px; display: inline-flex; align-items: center; gap: 6px; cursor: pointer; transition: all 0.2s; white-space: nowrap;
    }
    .report-btn:hover { background: rgba(239, 68, 68, 0.25); border-color: rgba(239, 68, 68, 0.4); }

    /* Horizontal Server Selection Buttons */
    .server-btn {
        background: rgba(255, 255, 255, 0.05); 
        border: 1px solid rgba(255, 255, 255, 0.1); 
        color: #9ca3af;
        padding: 0.75rem 0.5rem; 
        border-radius: 0.5rem; 
        font-size: 0.75rem; 
        font-weight: 800;
        text-transform: uppercase; 
        letter-spacing: 0.05em; 
        cursor: pointer; 
        transition: all 0.3s ease;
        flex: 0 0 auto;
        /* Mobile: Exactly 3 on screen (100% / 3) minus gap compensation */
        width: calc(33.333% - 6px); 
        text-align: center;
        white-space: nowrap;
    }
    
    @media (min-width: 768px) {
        .server-btn {
            /* Laptop/Tablet: Auto width, matches the reference image */
            width: auto;
            min-width: 110px;
            padding: 0.75rem 1.5rem;
        }
    }

    .server-btn:hover { border-color: rgba(34, 211, 238, 0.5); color: #fff; background: rgba(34, 211, 238, 0.1); }
    .server-btn.active { 
        background: var(--accent-blue); 
        border-color: var(--accent-blue); 
        color: #fff; 
        box-shadow: 0 0 15px rgba(59, 130, 246, 0.4); 
    }

    /* ==========================================================================
       Rating System (Emoji Bar)
       ========================================================================== */
    .sentiment-btn {
        position: relative; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1);
        width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center;
        color: #9ca3af; cursor: pointer; transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .sentiment-btn i { font-size: 24px; transition: transform 0.2s ease; }
    .sentiment-btn:hover { transform: translateY(-4px) scale(1.1); background: rgba(59, 130, 246, 0.15); border-color: rgba(59, 130, 246, 0.4); box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4); }
    .sentiment-btn:hover i { transform: scale(1.1); }

    .sentiment-tooltip {
        position: absolute; bottom: -30px; left: 50%; transform: translateX(-50%) scale(0.8);
        opacity: 0; pointer-events: none; background: #151b23; border: 1px solid rgba(255,255,255,0.1);
        color: #fff; font-size: 10px; font-weight: 800; text-transform: uppercase; padding: 4px 8px;
        border-radius: 6px; white-space: nowrap; transition: all 0.2s ease; z-index: 50;
    }
    .sentiment-btn:hover .sentiment-tooltip { opacity: 1; transform: translateX(-50%) scale(1); bottom: -35px; }

    @media (max-width: 420px) {
        .sentiment-btn { width: 40px; height: 40px; }
        .sentiment-btn i { font-size: 20px; }
    }

    /* ==========================================================================
       Community Comments & Share Section
       ========================================================================== */
    .comment-thread { display: flex; flex-direction: column; gap: 1rem; width: 100%; }
    .comment-node {
        position: relative; background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 1rem; padding: 1rem; transition: all 0.3s ease; width: 100%; word-wrap: break-word;
    }
    .comment-node:hover { background: rgba(255, 255, 255, 0.06); border-color: rgba(59, 130, 246, 0.3); }

    .reply-node {
        background: rgba(59, 130, 246, 0.06); border: 1px solid rgba(59, 130, 246, 0.15);
        border-radius: 0.875rem; padding: 0.875rem; position: relative; width: 100%; word-wrap: break-word;
    }

    @media (min-width: 641px) {
        .reply-node { margin-left: 1rem; width: calc(100% - 1rem); }
        .reply-thread-line {
            position: absolute; left: -1rem; top: -1rem; bottom: 0; width: 2px;
            background: linear-gradient(to bottom, #3b82f6, rgba(59, 130, 246, 0.1)); border-radius: 2px;
        }
        .reply-thread-line::before {
            content: ''; position: absolute; left: 0; top: 1.5rem; width: 0.75rem;
            height: 2px; background: #3b82f6; border-radius: 2px;
        }
    }
    @media (max-width: 640px) {
        .reply-node { margin-left: 0; border-left: 3px solid #3b82f6; padding-left: 0.75rem; }
        .reply-thread-line { display: none; }
    }

    .reply-container { position: relative; margin-top: 1rem; width: 100%; }
    .action-btn {
        font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px;
        display: flex; align-items: center; gap: 4px; padding: 6px 10px; border-radius: 6px;
        transition: all 0.2s; min-width: 32px; min-height: 28px; justify-content: center; cursor: pointer; border: none; flex-shrink: 0;
    }
    .reply-trigger { color: #3b82f6; background: rgba(59, 130, 246, 0.1); border: 1px solid rgba(59, 130, 246, 0.2); }
    .reply-trigger:hover { background: rgba(59, 130, 246, 0.2); transform: translateY(-1px); }
    .delete-trigger { color: #ef4444!important; background: rgba(239, 68, 68, 0.15)!important; border: 1px solid rgba(239, 68, 68, 0.3)!important; }
    .delete-trigger:hover { background: rgba(239, 68, 68, 0.3)!important; transform: translateY(-1px); }

    .staff-tag { background: #3b82f6; color: white; font-size: 8px; padding: 2px 6px; border-radius: 4px; margin-left: 6px; font-weight: 900; flex-shrink: 0; }
    .comment-badge { display: inline-flex; align-items: center; gap: 4px; font-size: 9px; font-weight: 900; text-transform: uppercase; padding: 2px 8px; border-radius: 6px; letter-spacing: 0.5px; flex-shrink: 0; }
    .comment-badge.reply { background: rgba(59, 130, 246, 0.2); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.3); }

    .share-box {
        background: linear-gradient(135deg, rgba(15, 23, 42, 0.7), rgba(30, 27, 75, 0.7)); border: 1px solid rgba(96,165,250,0.3);
        border-radius: 24px; padding: 32px; backdrop-filter: blur(24px);
        box-shadow: 0 20px 50px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.1); position: relative; overflow: hidden;
    }
    .share-title { background: linear-gradient(90deg, #60a5fa, #a78bfa, #f472b6); -webkit-background-clip: text; background-clip: text; color: transparent; font-family: 'Orbitron', sans-serif; }
    .share-btn { width: 56px; height: 56px; border-radius: 18px; display: flex; align-items: center; justify-content: center; font-size: 24px; color: #fff; transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); border: 1px solid rgba(255,255,255,0.1); cursor: pointer; box-shadow: 0 4px 15px rgba(0,0,0,0.3); }
    .share-btn:hover { transform: translateY(-5px) scale(1.15); box-shadow: 0 12px 25px rgba(0,0,0,0.5); border-color: rgba(255,255,255,0.3); }
    .btn-tg { background: linear-gradient(135deg, #0088cc, #00aaff); } .btn-wa { background: linear-gradient(135deg, #25D366, #1DA851); } .btn-x { background: linear-gradient(135deg, #14171a, #000000); } .btn-rd { background: linear-gradient(135deg, #FF4500, #FF6314); } .btn-share { background: linear-gradient(135deg, #6366f1, #8b5cf6); }
     @media (max-width: 640px) { .share-box { padding: 20px 12px; border-radius: 16px; } .share-btn { width: 40px; height: 40px; font-size: 18px; border-radius: 10px; } }
  </style>

<!-- External Libraries -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<!-- Data Stores for JS Processing -->
<script id="anime-data" type="application/json">
    <%- JSON.stringify({
        imageUrl: anime.imageUrl,
        _id: anime._id,
        name: anime.name,
        type: anime.type || 'series',
        seasons: anime.seasons.map(season => ({
            seasonNumber: season.seasonNumber,
            episodes: season.episodes.map(episode => ({
                episodeNumber: episode.episodeNumber,
                title: episode.title,
                mainServerName: episode.mainServerName || 'Main',
                videoUrl: episode.videoUrl || '',
                embedCode: episode.embedCode || '',
                imageUrl: episode.imageUrl || '',
                servers: episode.servers || []
            }))
        }))
    }) %>
</script>

<script id="user-data" type="application/json">
    <%- JSON.stringify({
        userId: session.userId || session.adminId || null,
        isLoggedIn: !!(session.userId || session.adminId)
    }) %>
</script>

<div class="container mx-auto px-4 py-8 max-w-6xl">

    <!-- Hero Section -->
    <div class="glass-card mb-10 p-6 md:p-8 flex flex-col md:flex-row gap-8 items-center">
        <div class="relative group flex-shrink-0">
            <img src="<%= anime.imageUrl %>" alt="<%= anime.name %>" class="w-full md:w-64 rounded-xl shadow-2xl object-cover transition-transform duration-500 hover:scale-105">
        </div>
        <div class="flex-1 space-y-4 min-w-0 text-center md:text-left">
            <h1 class="text-3xl md:text-5xl font-black tracking-tighter uppercase leading-tight break-words">
                <% const nameParts = anime.name.split(' '); %>
                <span class="text-white"><%= nameParts[0] %></span>
                <span class="text-yellow-400"><%= nameParts.slice(1).join(' ') %></span>
            </h1>
            <div class="flex flex-wrap justify-center md:justify-start gap-3 text-sm font-bold uppercase tracking-widest text-gray-400">
                <% if (anime.status) { %>
                    <span class="bg-cyan-500/10 text-cyan-400 px-3 py-1.5 rounded-full border border-cyan-500/20 shadow-[0_0_10px_rgba(34,211,238,0.2)]">
                        <i class="fas fa-signal mr-1"></i> <%= anime.status %>
                    </span>
                <% } %>
                <span class="bg-white/5 px-3 py-1.5 rounded-full border border-white/5">📅 <%= anime.year || '2024' %></span>
                <span class="bg-blue-500/10 text-blue-400 px-3 py-1.5 rounded-full border border-blue-500/20">HD Dual Audio</span>
                <% if(anime.type === 'movie') { %>
                    <span class="bg-red-500/10 text-red-400 px-3 py-1.5 rounded-full border border-red-500/20">🎬 Movie</span>
                <% } else { %>
                    <span class="bg-purple-500/10 text-purple-400 px-3 py-1.5 rounded-full border border-purple-500/20">📺 Series</span>
                <% } %>
            </div>
            <p class="text-gray-400 leading-relaxed font-medium text-sm md:text-base md:border-l-2 border-blue-500 md:pl-4 break-words">
                <%= anime.description %>
            </p>
        </div>
    </div>

    <!-- Rating System -->
    <% 
       let displayScore = anime.ratingScore ? anime.ratingScore.toFixed(1) : "0.0";
       let displayCount = anime.ratingCount ? anime.ratingCount : 0;
       let percentage = anime.ratingScore ? Math.round((anime.ratingScore / 10) * 100) : 0;
    %>
    <div class="rating-box my-6 p-5 rounded-2xl bg-black/40 border border-white/10 flex flex-col md:flex-row items-center justify-between gap-6 w-full">
        <div class="flex items-center gap-5 w-full md:w-auto justify-center md:justify-start">
            <div class="relative flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-br from-yellow-500/20 to-orange-500/20 border border-yellow-500/30 text-yellow-400 flex-shrink-0 shadow-lg">
                <span id="average-score" class="text-2xl font-black"><%= displayScore %></span>
                <span class="text-[9px] absolute bottom-1 font-bold text-gray-400">/ 10</span>
            </div>
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <div class="flex text-yellow-400 text-sm"><i class="fas fa-star"></i></div>
                    <span class="text-sm font-black text-white" id="rating-percentage"><%= percentage %>% Positive</span>
                </div>
                <p class="text-xs font-bold uppercase tracking-wider text-gray-400">
                    Community Rating <span id="rating-count" class="text-blue-400 ml-1">(<%= displayCount %> Voted)</span>
                </p>
            </div>
        </div>
        <div class="w-full md:w-auto text-center md:text-right">
            <p class="text-xs font-black uppercase tracking-widest text-blue-400 mb-3 flex items-center justify-center md:justify-end gap-2">
                <i class="fas fa-fire text-orange-500"></i> Rate this Anime
            </p>
            <div class="flex flex-wrap items-center justify-center md:justify-end gap-1.5 sm:gap-3" id="sentiment-bar">
                <button type="button" data-value="2" class="sentiment-btn group flex-shrink-0"><i class="fa-solid fa-face-angry group-hover:text-red-500 transition-colors"></i><span class="sentiment-tooltip">Terrible</span></button>
                <button type="button" data-value="4" class="sentiment-btn group flex-shrink-0"><i class="fa-solid fa-face-frown group-hover:text-orange-500 transition-colors"></i><span class="sentiment-tooltip">Poor</span></button>
                <button type="button" data-value="6" class="sentiment-btn group flex-shrink-0"><i class="fa-solid fa-face-meh group-hover:text-yellow-400 transition-colors"></i><span class="sentiment-tooltip">Average</span></button>
                <button type="button" data-value="8" class="sentiment-btn group flex-shrink-0"><i class="fa-solid fa-face-smile group-hover:text-lime-400 transition-colors"></i><span class="sentiment-tooltip">Good</span></button>
                <button type="button" data-value="10" class="sentiment-btn group flex-shrink-0"><i class="fa-solid fa-face-grin-stars group-hover:text-emerald-400 transition-colors"></i><span class="sentiment-tooltip">Awesome!</span></button>
            </div>
        </div>
    </div>

    <!-- Video Area (Hidden by default until play is clicked) -->
    <div id="video-area" class="mb-12 hidden">
        <div class="glass-card p-2 md:p-3 shadow-2xl overflow-hidden bg-black/50 border border-white/5">
            <div id="player-container" class="relative w-full aspect-video bg-black rounded-lg overflow-hidden"></div>
        </div>
        
        <!-- Redesigned Video Controls: Horizontal on Laptop, neat on Mobile -->
        <div id="player-controls" class="mt-4 flex flex-col lg:flex-row justify-between items-start lg:items-center gap-4">
            
            <!-- Video Title -->
            <h2 id="active-video-title" class="text-xl md:text-2xl font-black text-white uppercase tracking-tight flex-1 min-w-0 break-words w-full"></h2>
            
            <!-- Controls Group (Matches image_555424.png horizontally on desktop) -->
            <div class="flex flex-wrap items-center gap-2 md:gap-3 shrink-0 w-full lg:w-auto">
                <button id="report-btn" class="report-btn" type="button"><i class="fas fa-flag"></i> Report</button>
                
                <div class="flex items-center gap-2">
                    <button id="prev-btn" class="player-control-btn" type="button"><i class="fas fa-backward"></i> Prev</button>
                    <button id="season-display-btn" class="player-control-btn season-display px-4" type="button"><i class="fas fa-layer-group"></i> S1</button>
                    <button id="next-btn" class="player-control-btn" type="button">Next <i class="fas fa-forward"></i></button>
                </div>

                <button type="button" data-action="close-player" class="text-[10px] md:text-xs font-black text-gray-500 hover:text-white uppercase tracking-widest flex items-center gap-1 transition-colors pl-2 md:pl-4 border-l border-white/10 h-full py-2">
                    <i class="fas fa-times text-sm md:text-base"></i> Close
                </button>
            </div>
        </div>
        
        <!-- Server Switcher (Horizontal Scrolling with Arrows) -->
        <div id="server-switcher-container" class="hidden mt-8 bg-[#0b0e11]/80 p-4 md:p-5 rounded-xl border border-white/5 shadow-lg">
            <div class="text-[10px] font-bold text-yellow-500 uppercase mb-4 text-center bg-yellow-500/10 border border-yellow-500/20 rounded-lg py-2.5 px-3 tracking-widest">
                <i class="fas fa-exclamation-triangle mr-1"></i> If Video is Not Playing, Use Other Servers Or USE 1.1.1.1 VPN.
            </div>
            <h3 class="text-xs font-black text-gray-400 uppercase mb-3 tracking-widest">Select Server:</h3>
            
            <!-- Scrollable Server Wrapper -->
            <div class="relative flex items-center w-full group">
                <!-- Left Server Scroll Arrow -->
                <button id="server-scroll-left-btn" class="hidden absolute left-0 z-10 bg-gradient-to-r from-[#0b0e11] via-[#0b0e11] to-transparent pr-4 h-full flex items-center justify-start text-blue-500 hover:text-white transition-all drop-shadow-md">
                    <div class="bg-blue-600/20 w-6 h-6 flex items-center justify-center rounded-full backdrop-blur-sm border border-blue-500/30 hover:bg-blue-600 hover:shadow-[0_0_15px_rgba(59,130,246,0.8)]">
                        <i class="fas fa-chevron-left text-[10px]"></i>
                    </div>
                </button>

                <!-- Scrollable Server Buttons -->
                <div class="flex-1 overflow-x-auto hide-scrollbar flex items-center gap-2 py-2 scroll-smooth" id="server-buttons">
                    <!-- Injected via JS -->
                </div>

                <!-- Right Server Scroll Arrow -->
                <button id="server-scroll-right-btn" class="hidden absolute right-0 z-10 bg-gradient-to-l from-[#0b0e11] via-[#0b0e11] to-transparent pl-4 h-full flex items-center justify-end text-blue-500 hover:text-white transition-all drop-shadow-md">
                    <div class="bg-blue-600/20 w-6 h-6 flex items-center justify-center rounded-full backdrop-blur-sm border border-blue-500/30 hover:bg-blue-600 hover:shadow-[0_0_15px_rgba(59,130,246,0.8)]">
                        <i class="fas fa-chevron-right text-[10px]"></i>
                    </div>
                </button>
            </div>
        </div>
    </div>

    <!-- Special Info Announcement -->
    <% if(anime.specialInfo && anime.specialInfo.trim() !== '') { %>
    <div class="glass-card p-4 md:p-6 mb-8 border border-yellow-500/30 bg-gradient-to-r from-yellow-500/10 to-orange-500/5">
        <div class="flex flex-col items-center text-center gap-3">
            <svg class="w-8 h-8 text-yellow-500 mx-auto" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path></svg>
            <div class="w-full">
                <h3 class="text-sm md:text-base font-black text-yellow-400 uppercase tracking-wide mb-2">📢 Anime Update</h3>
                <p class="text-white/90 text-sm md:text-base font-semibold leading-relaxed whitespace-pre-wrap"><%= anime.specialInfo %></p>
            </div>
        </div>
    </div>
    <% } %>

    <!-- Episodes / Movie Play Area -->
    <% if(anime.type === 'movie') { %>
        <div class="text-center mb-12">
            <% if(anime.seasons && anime.seasons[0] && anime.seasons[0].episodes && anime.seasons[0].episodes.length > 0) { %>
                <button class="play-movie-btn" data-anime-id="<%= anime._id %>" data-anime-name="<%= anime.name %>" data-anime-img="<%= anime.imageUrl %>">
                    <i class="fas fa-play text-lg"></i> Play Movie
                </button>
                <p class="text-gray-500 text-xs font-bold uppercase mt-4 tracking-widest">Click to watch full movie</p>
            <% } else { %>
                <div class="glass-card p-8 text-center"><p class="text-gray-600 font-bold uppercase text-sm tracking-widest">Movie file not uploaded yet</p></div>
            <% } %>
        </div>
    <% } else { %>

        <!-- MODERN HORIZONTAL SEASON TABS WITH ARROWS -->
        <div class="flex flex-col mb-10 relative">
            <h2 class="text-xl md:text-2xl font-black uppercase tracking-tighter flex items-center gap-3 mb-5 flex-shrink-0 text-white">
                Choose Season <i class="fas fa-chevron-down text-blue-500 text-sm ml-1"></i>
            </h2>
            
            <div class="relative flex items-center w-full group">
                <!-- Left Scroll Arrow -->
                <button id="scroll-left-btn" class="hidden absolute left-0 z-10 bg-gradient-to-r from-[#0b0e11] via-[#0b0e11] to-transparent pr-8 h-full flex items-center justify-start text-blue-500 hover:text-white transition-all drop-shadow-md">
                    <div class="bg-blue-600/20 w-8 h-8 flex items-center justify-center rounded-full backdrop-blur-sm border border-blue-500/30 hover:bg-blue-600 hover:shadow-[0_0_15px_rgba(59,130,246,0.8)]">
                        <i class="fas fa-chevron-left text-sm"></i>
                    </div>
                </button>

                <!-- Scrollable Container -->
                <div class="flex-1 overflow-x-auto hide-scrollbar flex items-center gap-2 py-2 scroll-smooth" id="season-tabs-container">
                    <% anime.seasons.forEach((season, index) => { %>
                        <button class="season-tab-btn whitespace-nowrap px-6 py-3 rounded-lg font-black text-xs uppercase tracking-widest transition-all duration-300 
                            <%= index === 0 ? 'bg-gradient-to-br from-[#1c1836] to-[#120f26] text-white border border-purple-500/50 shadow-[0_0_15px_rgba(168,85,247,0.3)]' : 'bg-transparent text-gray-400 hover:text-white border border-white/5 hover:border-white/20' %>" 
                            data-target="<%= index %>">
                            Season <%= season.seasonNumber %>
                        </button>
                    <% }) %>
                </div>

                <!-- Right Scroll Arrow -->
                <button id="scroll-right-btn" class="absolute right-0 z-10 bg-gradient-to-l from-[#0b0e11] via-[#0b0e11] to-transparent pl-8 h-full flex items-center justify-end text-blue-500 hover:text-white transition-all drop-shadow-md">
                    <div class="bg-blue-600/20 w-8 h-8 flex items-center justify-center rounded-full backdrop-blur-sm border border-blue-500/30 hover:bg-blue-600 hover:shadow-[0_0_15px_rgba(59,130,246,0.8)]">
                        <i class="fas fa-chevron-right text-sm"></i>
                    </div>
                </button>
            </div>
        </div>

        <div id="episodes-container">
            <% anime.seasons.forEach((season, seasonIndex) => { %>
                <div class="season-section <%= seasonIndex === 0 ? '' : 'hidden' %>" data-season="<%= seasonIndex %>">
                    
                    <!-- EPISODE GRID -->
                    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 md:gap-4" id="grid-season-<%= seasonIndex %>">
                        <% season.episodes.forEach((episode, epIndex) => { %>
                            <div class="episode-card cursor-pointer group <%= epIndex >= 24 ? 'hidden hidden-ep' : '' %>" 
                                 data-season-index="<%= seasonIndex %>" 
                                 data-episode-index="<%= epIndex %>" 
                                 data-season-number="<%= season.seasonNumber %>" 
                                 data-anime-id="<%= anime._id %>" 
                                 data-anime-name="<%= anime.name %>" 
                                 data-anime-img="<%= anime.imageUrl %>">
                                
                                <div class="ep-image-container relative aspect-video">
                                    <img src="<%= episode.imageUrl || anime.imageUrl %>" loading="lazy">
                                    <div class="mini-play-icon">
                                        <i class="fas fa-play text-white text-[8px] ml-0.5"></i>
                                    </div>
                                </div>
                                <div class="p-3 md:p-4 flex justify-between items-center bg-[#0a0c10] border-t border-white/5">
                                    <div class="min-w-0 pr-2">
                                        <h4 class="font-black text-lg md:text-xl text-cyan-400 tracking-tighter leading-none mb-1.5 truncate"><%= season.seasonNumber %>x<%= episode.episodeNumber %></h4>
                                        <p class="text-[9px] md:text-[10px] text-gray-500 font-bold uppercase tracking-widest truncate">S<%= season.seasonNumber %>|E<%= episode.episodeNumber %></p>
                                    </div>
                                    <div class="card-play-btn">
                                        <i class="fas fa-play"></i>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>

                    <!-- LOAD MORE BUTTON -->
                    <% if (season.episodes.length > 24) { %>
                        <div class="text-center mt-10 pb-4">
                            <button class="load-more-btn bg-white/5 border border-white/10 text-cyan-400 hover:text-white hover:bg-cyan-600 hover:border-cyan-500 hover:shadow-[0_0_20px_rgba(34,211,238,0.4)] px-8 py-3.5 rounded-xl font-black text-xs uppercase tracking-widest transition-all duration-300" data-season="<%= seasonIndex %>">
                                Load More Episodes (<%= season.episodes.length - 24 %> Remaining)
                            </button>
                        </div>
                    <% } %>

                </div>
            <% }) %>
        </div>
    <% } %>

    <!-- Community Comments -->
    <div class="mt-20 glass-card p-4 md:p-10">
        <h2 class="text-2xl md:text-3xl font-black uppercase tracking-tighter mb-6 flex items-center gap-3">
            <i class="fas fa-comments text-blue-500"></i> Community <span class="text-blue-500">Voice</span>
        </h2>
        <%- include('partials/flash') %>
        
        <form action="/anime/comment/<%= anime._id %>" method="POST" class="mb-8 md:mb-12">
            <div class="space-y-4">
                <div>
                    <label class="block text-xs font-black uppercase tracking-widest text-gray-400 mb-2">Comment * <span class="text-red-500">Required</span></label>
                    <textarea name="content" rows="4" class="w-full p-4 rounded-2xl bg-black/40 border border-white/10 text-white focus:border-blue-500 focus:ring-1 focus:ring-blue-500/50 outline-none transition-all" placeholder="Share your thoughts..." required maxlength="500"></textarea>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-black uppercase tracking-widest text-gray-400 mb-2">Name * <span class="text-red-500">Required</span></label>
                        <input type="text" name="guestName" class="w-full p-3 rounded-xl bg-black/40 border border-white/10 text-white focus:border-blue-500 focus:ring-1 outline-none" placeholder="Your name" required maxlength="50">
                    </div>
                    <div>
                        <label class="block text-xs font-black uppercase tracking-widest text-gray-400 mb-2">Email * <span class="text-red-500">Required</span></label>
                        <input type="email" name="guestEmail" class="w-full p-3 rounded-xl bg-black/40 border border-white/10 text-white focus:border-blue-500 focus:ring-1 outline-none" placeholder="your@email.com" required>
                    </div>
                </div>
                <button type="submit" class="w-full md:w-auto bg-blue-600 text-white px-6 py-3 rounded-xl font-black uppercase text-xs tracking-widest hover:bg-blue-500 transition-all shadow-lg shadow-blue-600/30">Post Comment</button>
            </div>
        </form>

        <div class="comment-thread">
        <% 
        const currentGuestId = typeof guestId !== 'undefined' ? guestId : '';
        function renderThreadedComments(commentList, depth = 0) {
            commentList.forEach(function(comment) {
                const isOwner = comment.guestId && comment.guestId === currentGuestId;
                const isAdmin = !!session.isAdminAuthenticated;
                const isReply = depth > 0;
        %>
            <div class="<%= isReply ? 'reply-container' : '' %>">
                <div class="<%= isReply ? 'reply-node' : 'comment-node' %>">
                    <% if(isReply) { %><div class="reply-thread-line"></div><% } %>
                    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-3 mb-3">
                        <div class="flex items-start gap-3 flex-1 min-w-0">
                            <div class="w-8 h-8 rounded-full bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center text-xs font-black text-white flex-shrink-0 shadow-md">
                                <%= (comment.username || 'G').charAt(0).toUpperCase() %>
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex flex-wrap items-center gap-2">
                                    <span class="<%= comment.isAdmin ? 'text-blue-400' : 'text-white' %> font-black text-xs uppercase truncate"><%= comment.username || 'Guest' %></span>
                                    <% if(comment.isAdmin) { %><span class="staff-tag">MOD</span><% } %>
                                    <% if(isReply) { %><span class="comment-badge reply"><i class="fas fa-reply"></i> Reply</span><% } %>
                                </div>
                                <p class="text-gray-500 font-bold uppercase mt-0.5 text-[10px] tracking-wide">
                                    <%= new Date(comment.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                                </p>
                            </div>
                        </div>
                        <div class="flex items-center gap-2 flex-shrink-0">
                            <button type="button" data-action="reply" data-comment-id="<%= comment._id %>" class="action-btn reply-trigger"><i class="fas fa-reply"></i> Reply</button>
                            <% if (isAdmin || isOwner) { %>
                                <button type="button" data-action="delete-comment" data-anime-id="<%= anime._id %>" data-comment-id="<%= comment._id %>" class="action-btn delete-trigger"><i class="fas fa-trash-alt"></i></button>
                            <% } %>
                        </div>
                    </div>
                    <p class="text-sm text-gray-300 leading-relaxed break-words"><%= comment.content %></p>

                    <div id="reply-form-<%= comment._id %>" class="hidden mt-4">
                        <form action="/anime/comment/reply/<%= anime._id %>/<%= comment._id %>" method="POST" class="bg-black/20 p-4 rounded-xl border border-white/5">
                            <textarea name="content" rows="2" class="w-full p-3 rounded-xl bg-black/60 border border-blue-500/30 text-white focus:border-blue-500 outline-none text-sm mb-3" placeholder="Write a reply..." required maxlength="500"></textarea>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-3">
                                <input type="text" name="guestName" class="w-full p-3 rounded-xl bg-black/60 border border-blue-500/30 text-white focus:border-blue-500 outline-none text-sm" placeholder="Your name *" required maxlength="50">
                                <input type="email" name="guestEmail" class="w-full p-3 rounded-xl bg-black/60 border border-blue-500/30 text-white focus:border-blue-500 outline-none text-sm" placeholder="your@email.com *" required>
                            </div>
                            <div class="flex gap-2">
                                <button type="submit" class="bg-blue-600 text-white px-5 py-2 rounded-lg font-black uppercase text-xs hover:bg-blue-500">Send Reply</button>
                                <button type="button" data-action="cancel-reply" data-comment-id="<%= comment._id %>" class="text-gray-400 hover:text-white font-black uppercase text-xs px-4 py-2">Cancel</button>
                            </div>
                        </form>
                    </div>
                </div>
                <% if (comment.replies && comment.replies.length > 0) { renderThreadedComments(comment.replies, depth + 1); } %>
            </div>
        <% }); } %>
        
        <% if (comments && comments.length > 0) { renderThreadedComments(comments); } else { %>
            <div class="text-center py-12 bg-black/20 rounded-2xl border border-white/5">
                <i class="fas fa-comment-slash text-4xl text-gray-600 mb-4 block"></i>
                <p class="text-gray-500 font-bold uppercase text-xs tracking-widest">No conversation yet. Be the first to speak!</p>
            </div>
        <% } %>
        </div>
    </div>

    <!-- Share Section -->
    <div class="share-box mt-12">
      <h3 class="share-title text-2xl font-black mb-2 flex items-center justify-center gap-3"><i class="fa-solid fa-share-nodes"></i> Invite Your Nakama</h3>
      <p class="text-center text-gray-300 mb-8 text-sm">Share AniFusionStream and track anime together!</p>
      <div class="flex flex-col md:flex-row items-center justify-center gap-10">
        <div class="text-center md:border-r border-gray-600 md:pr-10">
          <p class="text-4xl font-black text-white drop-shadow-[0_0_15px_rgba(59,130,246,0.6)]">2.6k<span class="text-blue-500">+</span></p>
          <p class="text-xs text-gray-400 uppercase tracking-widest mt-1 font-bold">Otakus Joined</p>
        </div>
        <!-- Changed gap-5 to gap-3 md:gap-5 -->
        <div class="flex flex-wrap items-center justify-center gap-3 md:gap-5">
          <button class="share-btn btn-tg" data-platform="telegram" title="Share on Telegram"><i class="fa-brands fa-telegram"></i></button>
          <button class="share-btn btn-wa" data-platform="whatsapp" title="Share on WhatsApp"><i class="fa-brands fa-whatsapp"></i></button>
          <button class="share-btn btn-x" data-platform="twitter" title="Share on X / Twitter"><i class="fa-brands fa-x-twitter"></i></button>
          <button class="share-btn btn-rd" data-platform="reddit" title="Share on Reddit"><i class="fa-brands fa-reddit-alien"></i></button>
          <button class="share-btn btn-share" data-platform="native" title="More Options"><i class="fa-solid fa-link"></i></button>
        </div>
      </div>
    </div>

    <!-- Random Titles -->
    <div class="mt-12">
        <h2 class="text-2xl font-black mb-6 uppercase tracking-tighter">Random<span class="text-blue-500">Titles</span></h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-6">
            <% (randomAnimes || []).forEach(function(r) { %>
                <div class="group bg-gray-800/50 rounded-xl p-2 hover:bg-gray-700/70 transition-all duration-300 hover:scale-105 hover:shadow-xl hover:shadow-blue-500/20">
                    <a href="/anime/<%= r._id %>">
                        <div class="relative overflow-hidden rounded-lg mb-2">
                            <img src="<%= r.imageUrl %>" class="w-full h-48 object-cover shadow-md transition-transform duration-300 group-hover:scale-110">
                            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end justify-center pb-2">
                                <span class="text-xs font-bold text-white uppercase tracking-wider">Watch Now</span>
                            </div>
                        </div>
                        <p class="text-center text-white group-hover:text-blue-400 font-bold text-xs truncate transition-colors"><%= r.name %></p>
                    </a>
                </div>
            <% }); %>
        </div>
    </div>
</div>

<!-- Report Modal -->
<div id="report-modal" class="report-modal hidden fixed inset-0 bg-black/90 backdrop-blur-sm z-50 items-center justify-center p-4 overflow-y-auto">
    <div class="glass-card w-full max-w-xl rounded-2xl border-white/10 shadow-2xl overflow-hidden my-8 mx-auto">
        <div class="p-5 border-b border-white/10 flex items-center justify-between">
            <h3 class="text-xl font-black text-white flex items-center gap-2"><i class="fas fa-flag text-red-500"></i> Report Video Issue</h3>
            <button type="button" id="close-report" class="text-gray-400 hover:text-white"><i class="fas fa-times"></i></button>
        </div>
        <form id="report-form" class="p-5">
            <div class="mb-4 p-3 bg-black/50 rounded-xl border border-white/5">
                <p class="text-xs text-gray-400 font-bold uppercase mb-2">Auto Information</p>
                <div id="report-info" class="text-xs text-gray-300 space-y-1 font-mono break-words"></div>
            </div>
            <div class="mb-4">
                <label class="text-xs text-gray-400 font-bold uppercase mb-2 block">Issue Type *</label>
                <select id="issue-type" required class="w-full p-3 rounded-xl bg-black/40 border border-white/10 text-white text-sm focus:border-red-500 focus:outline-none">
                    <option value="">Select an issue</option>
                    <option>Video Not Playing</option>
                    <option>Buffering/Lag</option>
                    <option>Video Quality/Blur</option>
                    <option>Audio Problem</option>
                    <option>Wrong Episode</option>
                    <option>Other</option>
                </select>
            </div>
            <div class="mb-4">
                <label class="text-xs text-gray-400 font-bold uppercase mb-2 block">Describe the Issue <span class="text-red-500">*</span></label>
                <textarea id="report-message" rows="4" required minlength="10" class="w-full p-3 rounded-xl bg-black/40 border-white/10 text-white text-sm placeholder-gray-500 focus:border-red-500 focus:outline-none resize-none" placeholder="Explain the problem in detail..."></textarea>
            </div>
            <div class="flex gap-3">
                <button type="submit" class="flex-1 bg-gradient-to-r from-red-600 to-red-500 hover:from-red-500 text-white px-6 py-3 rounded-xl font-black uppercase text-xs"><i class="fas fa-paper-plane mr-2"></i> Send Report</button>
                <button type="button" id="cancel-report" class="bg-gray-700 hover:bg-gray-600 text-white px-6 py-3 rounded-xl font-black uppercase text-xs">Cancel</button>
            </div>
        </form>
    </div>
</div>

<%- include('partials/footer') %>

<script>
    document.addEventListener('DOMContentLoaded', () => {
    // ==========================================================================
    // 1. Initialize Data & DOM Elements
    // ==========================================================================
    const userData = JSON.parse(document.getElementById('user-data').textContent);
    const animeData = JSON.parse(document.getElementById('anime-data').textContent);
    
    // Flatten episodes for easy navigation
    const allEpisodes = [];
    animeData.seasons.forEach((season, sIdx) => {
        season.episodes.forEach((episode, eIdx) => {
            allEpisodes.push({
                seasonIndex: sIdx, episodeIndex: eIdx,
                seasonNumber: season.seasonNumber, episodeNumber: episode.episodeNumber,
                title: episode.title, 
                mainServerName: episode.mainServerName, 
                videoUrl: episode.videoUrl, embedCode: episode.embedCode,
                poster: episode.imageUrl || animeData.imageUrl, servers: episode.servers || []
            });
        });
    });

    let currentEpisodeIndex = -1;

    // Element Selectors
    const seasonTabs = document.querySelectorAll('.season-tab-btn');
    const seasonSections = document.querySelectorAll('.season-section');
    const videoArea = document.getElementById('video-area');
    const playerContainer = document.getElementById('player-container');
    const videoTitleDisplay = document.getElementById('active-video-title');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    const seasonDisplayBtn = document.getElementById('season-display-btn');
    const playMovieBtn = document.querySelector('.play-movie-btn');
    const serverSwitcherContainer = document.getElementById('server-switcher-container');
    const serverButtonsContainer = document.getElementById('server-buttons');

    // Horizontal Scroll Elements (Seasons)
    const seasonTabsContainer = document.getElementById('season-tabs-container');
    const scrollLeftBtn = document.getElementById('scroll-left-btn');
    const scrollRightBtn = document.getElementById('scroll-right-btn');

    // Horizontal Scroll Elements (Servers)
    const serverScrollLeftBtn = document.getElementById('server-scroll-left-btn');
    const serverScrollRightBtn = document.getElementById('server-scroll-right-btn');

    // ==========================================================================
    // 1.5 Horizontal Season Tabs Logic & Scroll Arrows
    // ==========================================================================
    
    // Handle Arrow Visibility
    const updateArrows = () => {
        if (!seasonTabsContainer || !scrollRightBtn || !scrollLeftBtn) return;
        
        const { scrollLeft, scrollWidth, clientWidth } = seasonTabsContainer;
        
        if (scrollLeft > 0) {
            scrollLeftBtn.classList.remove('hidden');
        } else {
            scrollLeftBtn.classList.add('hidden');
        }
        
        if (scrollLeft + clientWidth >= scrollWidth - 2) {
            scrollRightBtn.classList.add('hidden');
        } else {
            scrollRightBtn.classList.remove('hidden');
        }
    };

    if (seasonTabsContainer) {
        seasonTabsContainer.addEventListener('scroll', updateArrows);
        window.addEventListener('resize', updateArrows);
        setTimeout(updateArrows, 100); 

        scrollRightBtn?.addEventListener('click', () => {
            seasonTabsContainer.scrollBy({ left: 200, behavior: 'smooth' });
        });

        scrollLeftBtn?.addEventListener('click', () => {
            seasonTabsContainer.scrollBy({ left: -200, behavior: 'smooth' });
        });
    }

    // Handle Server Arrow Visibility
    const updateServerArrows = () => {
        if (!serverButtonsContainer || !serverScrollRightBtn || !serverScrollLeftBtn) return;
        const { scrollLeft, scrollWidth, clientWidth } = serverButtonsContainer;
        
        if (scrollLeft > 0) serverScrollLeftBtn.classList.remove('hidden');
        else serverScrollLeftBtn.classList.add('hidden');
        
        if (scrollLeft + clientWidth >= scrollWidth - 2) serverScrollRightBtn.classList.add('hidden');
        else serverScrollRightBtn.classList.remove('hidden');
    };

    if (serverButtonsContainer) {
        serverButtonsContainer.addEventListener('scroll', updateServerArrows);
        window.addEventListener('resize', updateServerArrows);
        
        serverScrollRightBtn?.addEventListener('click', () => {
            serverButtonsContainer.scrollBy({ left: 150, behavior: 'smooth' });
        });
        serverScrollLeftBtn?.addEventListener('click', () => {
            serverButtonsContainer.scrollBy({ left: -150, behavior: 'smooth' });
        });
    }

    // Handle Tab Clicking
    if (seasonTabs.length > 0) {
        seasonTabs.forEach(tab => {
            tab.addEventListener('click', (e) => {
                const selected = e.target.dataset.target;

                // Reset all tabs to inactive styling
                seasonTabs.forEach(t => {
                    t.className = "season-tab-btn whitespace-nowrap px-6 py-3 rounded-lg font-black text-xs uppercase tracking-widest transition-all duration-300 bg-transparent text-gray-400 hover:text-white border border-white/5 hover:border-white/20";
                });

                // Set clicked tab to active styling
                e.target.className = "season-tab-btn whitespace-nowrap px-6 py-3 rounded-lg font-black text-xs uppercase tracking-widest transition-all duration-300 bg-gradient-to-br from-[#1c1836] to-[#120f26] text-white border border-purple-500/50 shadow-[0_0_15px_rgba(168,85,247,0.3)]";

                // Show target section with animation
                seasonSections.forEach(s => {
                    if (s.dataset.season === selected) {
                        s.classList.remove('hidden');
                        s.style.animation = 'fadeIn 0.4s ease-out';
                    } else {
                        s.classList.add('hidden');
                        s.style.animation = '';
                    }
                });
                
                closePlayer(); 
            });
        });
    }

    // ==========================================================================
    // "Load More" Episodes Logic (Batches of 24)
    // ==========================================================================
    document.querySelectorAll('.load-more-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
            const seasonIdx = e.target.dataset.season;
            const grid = document.getElementById(`grid-season-${seasonIdx}`);
            
            const hiddenEps = grid.querySelectorAll('.hidden-ep.hidden');
            
            const amountToLoad = Math.min(24, hiddenEps.length);
            for (let i = 0; i < amountToLoad; i++) {
                hiddenEps[i].classList.remove('hidden');
                hiddenEps[i].style.animation = 'fadeIn 0.4s ease-out forwards';
            }
            
            const remaining = grid.querySelectorAll('.hidden-ep.hidden').length;
            
            if (remaining === 0) {
                e.target.parentElement.style.display = 'none';
            } else {
                e.target.textContent = `Load More Episodes (${remaining} Remaining)`;
            }
        });
    });

    // ==========================================================================
    // 2. Video Player & Server Switching Logic
    // ==========================================================================
    
    // Play Movie
    if (playMovieBtn && animeData.type === 'movie' && allEpisodes.length > 0) {
        playMovieBtn.addEventListener('click', () => {
            playEpisode(0);
            saveToHistory(playMovieBtn.dataset.animeId, animeData.name, animeData.imageUrl, 1, 1);
        });
    }

    // Play specific Series episode
    document.querySelectorAll('.episode-card').forEach(card => {
        card.addEventListener('click', () => {
            const seasonIdx = parseInt(card.dataset.seasonIndex);
            const epIdx = parseInt(card.dataset.episodeIndex);
            currentEpisodeIndex = allEpisodes.findIndex(ep => ep.seasonIndex === seasonIdx && ep.episodeIndex === epIdx);
            playEpisode(currentEpisodeIndex);
            
            const epNum = allEpisodes[currentEpisodeIndex]?.episodeNumber;
            saveToHistory(card.dataset.animeId, animeData.name, animeData.imageUrl, card.dataset.seasonNumber, epNum);
        });
    });

    // Core Play Logic
    function playEpisode(index) {
        if (index < 0 || index >= allEpisodes.length) return;
        currentEpisodeIndex = index;
        const ep = allEpisodes[index];

        renderServerSwitcher(ep);

        playerContainer.innerHTML = '';
        if (ep.embedCode && ep.embedCode.trim() !== '') {
            playerContainer.innerHTML = ep.embedCode;
            const iframe = playerContainer.querySelector('iframe');
            if (iframe) iframe.className = "w-full h-full border-0";
        } else if (ep.videoUrl) {
            playerContainer.innerHTML = `<video controls autoplay poster="${ep.poster}"><source src="${ep.videoUrl}" type="video/mp4"></video>`;
        }

        // Setup Title & Controls
        videoTitleDisplay.textContent = animeData.type === 'movie' ? animeData.name : `S${ep.seasonNumber} Ep ${ep.episodeNumber}: ${ep.title}`;
        if(seasonDisplayBtn) seasonDisplayBtn.innerHTML = animeData.type === 'movie' ? `<i class="fas fa-film"></i> Movie` : `<i class="fas fa-layer-group"></i> S${ep.seasonNumber}`;

        if (animeData.type === 'movie') {
            if(prevBtn) prevBtn.disabled = true;
            if(nextBtn) nextBtn.disabled = true;
        } else {
            const currentSeason = ep.seasonNumber;
            prevBtn.disabled = !allEpisodes[index - 1] || allEpisodes[index - 1].seasonNumber !== currentSeason;
            nextBtn.disabled = !allEpisodes[index + 1] || allEpisodes[index + 1].seasonNumber !== currentSeason;
        }

        videoArea.classList.remove('hidden');
        videoArea.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    // Render Multiple Servers
    function renderServerSwitcher(episode) {
        const hasMainServer = episode.videoUrl || episode.embedCode;
        
        if (!hasMainServer && (!episode.servers || episode.servers.length === 0)) {
            if (serverSwitcherContainer) serverSwitcherContainer.classList.add('hidden');
            return;
        }

        if (serverSwitcherContainer) {
            serverSwitcherContainer.classList.remove('hidden');

            const servers = [];
            
            // 1. Add Main Server
            if (hasMainServer) {
                servers.push({
                    name: episode.mainServerName || 'Main',
                    videoUrl: episode.videoUrl,
                    embedCode: episode.embedCode,
                    type: episode.embedCode ? 'iframe' : 'direct'
                });
            }

            // 2. Add Additional Servers (With strict De-Duplication)
            if (episode.servers && episode.servers.length > 0) {
                episode.servers.forEach(srv => {
                    const isDuplicateVideo = hasMainServer && episode.videoUrl && srv.videoUrl === episode.videoUrl;
                    const isDuplicateEmbed = hasMainServer && episode.embedCode && srv.embedCode === episode.embedCode;
                    
                    if (!isDuplicateVideo && !isDuplicateEmbed) {
                        servers.push(srv);
                    }
                });
            }

            // 3. Render Buttons
            serverButtonsContainer.innerHTML = '';
            servers.forEach((server, idx) => {
                const btn = document.createElement('button');
                btn.className = `server-btn ${idx === 0 ? 'active' : ''}`;
                btn.id = `server-${idx === 0 ? 'main' : idx - 1}`;
                btn.textContent = server.name; 
                
                btn.onclick = () => {
                    document.querySelectorAll('.server-btn').forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    if (server.type === 'iframe') playerContainer.innerHTML = server.embedCode;
                    else playerContainer.innerHTML = `<video src="${server.videoUrl}" controls class="w-full h-full" autoplay></video>`;
                };
                
                serverButtonsContainer.appendChild(btn);
            });

            window.currentServers = servers;
            setTimeout(updateServerArrows, 100);
        }
    }

    // Next/Prev Buttons
    prevBtn?.addEventListener('click', () => { if(!prevBtn.disabled) playEpisode(currentEpisodeIndex - 1); });
    nextBtn?.addEventListener('click', () => { if(!nextBtn.disabled) playEpisode(currentEpisodeIndex + 1); });

    function closePlayer() {
        videoArea?.classList.add('hidden');
        if(playerContainer) playerContainer.innerHTML = '';
        if(serverSwitcherContainer) serverSwitcherContainer.classList.add('hidden');
        currentEpisodeIndex = -1;
    }

    // ==========================================================================
    // 3. Rating System Logic
    // ==========================================================================
    document.querySelectorAll('#sentiment-bar .sentiment-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
            try {
                const response = await fetch(`/anime/rate/${animeData._id}`, {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ rating: parseInt(btn.dataset.value) })
                });
                const data = await response.json();
                if (data.success) {
                    document.getElementById('average-score').textContent = data.newAverage.toFixed(1);
                    document.getElementById('rating-count').textContent = `(${data.newCount} Voted)`;
                    document.getElementById('rating-percentage').textContent = `${data.newPercentage}% Positive`;
                    Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: 'Vote saved!', showConfirmButton: false, timer: 2000, background: '#151b23', color: '#fff' });
                } else {
                    Swal.fire({ icon: 'info', title: 'Notice', text: data.message, background: '#0b0e11', color: '#fff' });
                }
            } catch (err) {
                Swal.fire({ icon: 'error', title: 'Error', text: 'Could not reach server.', background: '#0b0e11', color: '#fff' });
            }
        });
    });

    // ==========================================================================
    // 4. Community Comments Logic (Reply/Delete Toggles)
    // ==========================================================================
    document.addEventListener('click', (e) => {
        const target = e.target.closest('[data-action]');
        if (!target) return;

        const action = target.dataset.action;
        const cId = target.dataset.commentId;

        if (action === 'close-player') closePlayer();
        else if (action === 'reply' || action === 'cancel-reply') {
            const form = document.getElementById(`reply-form-${cId}`);
            if(form) {
                form.classList.toggle('hidden');
                if(!form.classList.contains('hidden')) form.querySelector('textarea').focus();
            }
        } 
        else if (action === 'delete-comment') {
            Swal.fire({
                title: 'Delete Comment?', text: "Cannot be undone.", icon: 'warning',
                background: '#0b0e11', color: '#fff', showCancelButton: true,
                confirmButtonColor: '#ef4444', confirmButtonText: 'Yes, delete!'
            }).then((res) => {
                if (res.isConfirmed) {
                    const form = document.createElement('form');
                    form.method = 'POST'; form.action = `/anime/comment/delete/${target.dataset.animeId}/${cId}`;
                    document.body.appendChild(form); form.submit();
                }
            });
        }
    });

    // ==========================================================================
    // 5. Share Logic
    // ==========================================================================
    const shareUrl = window.location.href; 
    const shareTitle = `Watch ${animeData.name} on AniFusionStream`;
    const shareText = `Watching ${animeData.name} on AniFusionStream! Catch it in HD here:`;

    document.querySelectorAll('.share-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const platform = btn.dataset.platform;
            let url = '';
            switch(platform) {
                case 'telegram': url = `https://t.me/share/url?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(shareText)}`; window.open(url, '_blank'); break;
                case 'whatsapp': url = `https://api.whatsapp.com/send?text=${encodeURIComponent(shareText + '\n\n' + shareUrl)}`; window.open(url, '_blank'); break;
                case 'twitter': url = `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(shareUrl)}`; window.open(url, '_blank'); break;
                case 'reddit': url = `https://reddit.com/submit?url=${encodeURIComponent(shareUrl)}&title=${encodeURIComponent(shareTitle)}`; window.open(url, '_blank'); break;
                case 'native':
                    if(navigator.share) navigator.share({ title: shareTitle, text: shareText, url: shareUrl }).catch(console.error);
                    else {
                        navigator.clipboard.writeText(shareUrl);
                        const original = btn.innerHTML;
                        btn.innerHTML = '<i class="fa-solid fa-check"></i>';
                        setTimeout(() => { btn.innerHTML = original; }, 2000);
                        Swal.fire({toast: true, position: 'top-end', icon:'success', title: 'Link copied!', timer: 1500, showConfirmButton: false, background: '#151b23', color: '#fff'});
                    }
                    break;
            }
        });
    });

    // ==========================================================================
    // 6. Report Video Modal Logic
    // ==========================================================================
    const reportModal = document.getElementById('report-modal');
    const reportForm = document.getElementById('report-form');

    document.addEventListener('click', (e) => {
        if(e.target.closest('#report-btn')) {
            if(currentEpisodeIndex === -1) return Swal.fire({icon: 'info', title: 'Play Video First'});
            const ep = allEpisodes[currentEpisodeIndex];
            document.getElementById('report-info').innerHTML = `
                <div><span class="text-gray-500">Anime:</span> ${animeData.name}</div>
                <div><span class="text-gray-500">Ep:</span> S${ep.seasonNumber} E${ep.episodeNumber} - ${ep.title}</div>
            `;
            reportForm.reset();
            reportModal.classList.remove('hidden'); reportModal.classList.add('flex');
        }
        else if (e.target.closest('#close-report') || e.target.closest('#cancel-report') || e.target === reportModal) {
            reportModal.classList.add('hidden'); reportModal.classList.remove('flex');
        }
    });

    reportForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const issueType = document.getElementById('issue-type').value;
        const desc = document.getElementById('report-message').value.trim();
        const ep = allEpisodes[currentEpisodeIndex];

        const msg = `🚨 NEW VIDEO REPORT 🚨\nAnime: ${animeData.name}\n${animeData.type !== 'movie' ? `Season: ${ep.seasonNumber} Episode:${ep.episodeNumber}` : ''}\nIssue: ${issueType}\nDesc: ${desc}`;
        
        try {
            const res = await fetch('/report-video', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({ message: msg }) });
            const data = await res.json();
            if(data.success) {
                Swal.fire({icon: 'success', title: 'Sent!', timer: 2000});
                reportModal.classList.add('hidden'); reportModal.classList.remove('flex');
            } else Swal.fire({icon: 'error', title: 'Failed', text: data.message});
        } catch (err) { Swal.fire({icon: 'error', title: 'Network Error'}); }
    });

    // ==========================================================================
    // 7. Watch History Logic (localStorage)
    // ==========================================================================
    const HISTORY_KEY = `watchHistory_${userData.userId || 'guest'}`;
    
    function saveToHistory(animeId, animeName, animeImg, season, episode) {
        if (!userData.isLoggedIn) return;
        let history = JSON.parse(localStorage.getItem(HISTORY_KEY) || "[]");
        history = history.filter(item => item.animeId !== animeId);
        history.unshift({ animeId, animeName, animeImg, season: parseInt(season), episode: parseInt(episode), watchedAt: Date.now() });
        localStorage.setItem(HISTORY_KEY, JSON.stringify(history.slice(0, 20)));
    }
});
</script>