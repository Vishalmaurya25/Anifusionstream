<%- include('partials/header') %>

<style>
    /* ==========================================================================
       Global Variables & Base Setup
       ========================================================================== */
    :root {
        --bg-deep: #0b0e11;
        --card-navy: #151b23;
        --input-dark: #1c232d;
        --primary-blue: #3b82f6;
        --text-muted: #9ca3af;
        --danger-red: #ef4444;
        --success-green: #10b981;
    }

    /* Removed 'body' block to prevent conflicts with header.ejs padding and overflow lock */

    .admin-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 90vh;
        width: 100%;
        padding: 4rem 1.25rem;
    }

    .ui-card {
        background-color: var(--card-navy);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 2.5rem;
        width: 100%;
        max-width: 650px;
        padding: 3.5rem;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }

    .ui-label {
        font-size: 0.75rem;
        font-weight: 800;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 0.75rem;
        display: block;
    }

    .ui-input {
        background-color: var(--input-dark);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 1rem;
        color: #ffffff;
        padding: 1.1rem;
        width: 100%;
        transition: all 0.2s ease;
        font-size: 0.95rem;
        box-sizing: border-box;
    }

    .ui-input:focus {
        outline: none;
        border-color: var(--primary-blue);
        box-shadow: 0 0 0 1px var(--primary-blue);
    }

    .genre-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
        gap: 12px;
        background: rgba(0,0,0,0.2);
        padding: 1.5rem;
        border-radius: 1rem;
        border: 1px solid rgba(255,255,255,0.02);
        max-height: 250px;
        overflow-y: auto;
    }

    .genre-item {
        display: flex;
        align-items: center;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-muted);
        cursor: pointer;
        transition: color 0.2s;
    }

    .genre-item:hover { color: #fff; }

    input[type="checkbox"] {
        margin-right: 8px;
        accent-color: var(--primary-blue);
        width: 16px;
        height: 16px;
        cursor: pointer;
    }

    .ui-button {
        background-color: var(--primary-blue);
        color: #ffffff;
        font-weight: 800;
        padding: 1.2rem;
        border-radius: 1.25rem;
        width: 100%;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        border: none;
        cursor: pointer;
        margin-top: 1rem;
    }

    .ui-button:hover:not(:disabled) {
        transform: translateY(-2px);
        filter: brightness(1.1);
        box-shadow: 0 15px 30px rgba(59, 130, 246, 0.3);
    }

    .ui-button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .back-link {
        color: var(--text-muted);
        font-size: 0.75rem;
        font-weight: 800;
        text-decoration: none;
        margin-bottom: 2rem;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }

    .back-link:hover { color: #fff; }

    .type-selector {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .type-option {
        background: var(--input-dark);
        border: 2px solid rgba(255, 255, 255, 0.05);
        border-radius: 1rem;
        padding: 1.25rem;
        cursor: pointer;
        transition: all 0.3s ease;
        text-align: center;
        position: relative;
    }

    .type-option input[type="radio"] {
        position: absolute;
        opacity: 0;
    }

    .type-option:hover {
        border-color: rgba(59, 130, 246, 0.3);
        background: rgba(59, 130, 246, 0.05);
    }

    .type-option.active {
        border-color: var(--primary-blue);
        background: rgba(59, 130, 246, 0.1);
    }

    .type-icon {
        font-size: 2rem;
        margin-bottom: 0.5rem;
    }

    .type-label {
        font-size: 0.85rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .type-desc {
        font-size: 10px;
        color: var(--text-muted);
        margin-top: 0.25rem;
        font-weight: 600;
    }

    .form-error {
        color: var(--danger-red);
        font-size: 0.75rem;
        font-weight: 800;
        margin-top: 0.75rem;
        display: none;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .form-error.show { display: block; }

    @media (max-width: 640px) {
        .ui-card { padding: 2rem 1.5rem; }
        .genre-grid { grid-template-columns: repeat(2, 1fr); }
        .type-selector { grid-template-columns: 1fr; }
    }
</style>

<div class="admin-wrapper">

    <div class="text-center mb-10">
        <a href="/admin/dashboard" class="back-link">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
            Back to Dashboard
        </a>
        <h1 class="text-4xl md:text-5xl font-black tracking-tighter uppercase">
            Add New <span class="text-blue-500">Anime</span>
        </h1>
    </div>

    <div class="ui-card">
        <%- include('partials/flash') %>

        <form action="/admin/add-anime" method="POST" id="addAnimeForm">

            <div class="mb-8">
                <label class="ui-label">Content Type</label>
                <div class="type-selector">
                    <label class="type-option active" id="type-series">
                        <input type="radio" name="type" value="series" checked>
                        <div class="type-icon">📺</div>
                        <div class="type-label">TV Series</div>
                        <div class="type-desc">Multiple episodes & seasons</div>
                    </label>
                    <label class="type-option" id="type-movie">
                        <input type="radio" name="type" value="movie">
                        <div class="type-icon">🎬</div>
                        <div class="type-label">Movie</div>
                        <div class="type-desc">Single video file</div>
                    </label>
                </div>
            </div>

            <div class="mb-8">
                <label class="ui-label">Anime Name</label>
                <input type="text" name="name" class="ui-input" placeholder="e.g. Solo Leveling" required maxlength="200">
            </div>

            <div class="mb-8">
                <label class="ui-label">Poster Image URL</label>
                <input type="url" name="imageUrl" class="ui-input" placeholder="https://image-link.com/poster.jpg" required maxlength="500">
            </div>

            <div class="mb-8">
                <label class="ui-label">Description</label>
                <textarea name="description" rows="4" class="ui-input" placeholder="Write a brief synopsis..." required maxlength="2000"></textarea>
            </div>

            <div class="mb-10">
                <label class="ui-label">Select Genres (At least 1 required)</label>
                <div class="genre-grid">
                    <% if (genres && genres.length > 0) { %>
                        <% genres.forEach(genre => { %>
                            <label class="genre-item">
                                <input type="checkbox" name="genres" value="<%= genre._id %>">
                                <%= genre.name %>
                            </label>
                        <% }) %>
                    <% } else { %>
                        <p class="text-gray-500 text-sm col-span-full text-center">No genres available. Add some in Manage Categories.</p>
                    <% } %>
                </div>
                <div class="form-error" id="genreError">⚠️ Please select at least one genre before publishing.</div>
            </div>

            <div class="mb-8">
                <label class="ui-label">Special Information / Announcements (Optional)</label>
                <textarea name="specialInfo" rows="3" class="ui-input" placeholder="e.g. MORE EPISODE WILL BE ADDED AFTER RELEASE..." maxlength="500"></textarea>
                <p class="text-[10px] text-gray-500 mt-2 font-bold uppercase tracking-wider">Note: This will only appear on the anime page if filled.</p>
            </div>

            <button type="submit" class="ui-button" id="submitBtn">
                Publish to Catalog
            </button>
        </form>
    </div>
</div>

<script>
    // 1. Type selector toggle UI
    const typeOptions = document.querySelectorAll('.type-option');
    typeOptions.forEach(option => {
        option.addEventListener('click', () => {
            typeOptions.forEach(opt => opt.classList.remove('active'));
            option.classList.add('active');
            option.querySelector('input').checked = true;
        });
    });

    // 2. Form Validation: Enforce at least 1 genre selected
    const form = document.getElementById('addAnimeForm');
    const checkboxes = document.querySelectorAll('input[name="genres"]');
    const genreError = document.getElementById('genreError');
    const submitBtn = document.getElementById('submitBtn');

    form.addEventListener('submit', function(e) {
        // Check if there are any genres available to select
        if (checkboxes.length > 0) {
            let isChecked = false;
            for (let i = 0; i < checkboxes.length; i++) {
                if (checkboxes[i].checked) {
                    isChecked = true;
                    break;
                }
            }

            // If none are checked, block submission and show error
            if (!isChecked) {
                e.preventDefault();
                genreError.classList.add('show');
                
                // Scroll to the genre section so the admin sees the error
                genreError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                return;
            }
        }

        // Passed validation
        genreError.classList.remove('show');
        submitBtn.disabled = true;
        submitBtn.textContent = 'Publishing...';
    });

    // Remove error warning instantly if user clicks a checkbox after failing validation
    checkboxes.forEach(box => {
        box.addEventListener('change', () => {
            if (box.checked) {
                genreError.classList.remove('show');
            }
        });
    });
</script>

<%- include('partials/footer') %>