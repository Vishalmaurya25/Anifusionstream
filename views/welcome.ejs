      <h1 class="brand-text text-4xl sm:text-5xl md:text-7xl mb-5 break-words">AniFusionStream</h1>
      <p class="text-gray-300 text-lg md:text-xl mb-8 max-w-2xl mx-auto font-medium shadow-black drop-shadow-lg px-2">
        Your Personal Anime Note. Track your journey, discover hidden gems, and discuss every epic moment.
      </p>
      <a href="/home" class="btn-glow inline-flex items-center gap-3 px-10 py-4 md:px-12 md:py-5 text-sm font-black uppercase text-white tracking-wider">
        Enter Anifusionstream <i class="fa-solid fa-bolt text-yellow-300"></i>
      </a>
    </div>

    <!-- CATCHY INTRO -->
    <div class="section-glow text-center">
      <h2 class="text-3xl md:text-4xl font-black mb-3 brand-text break-words">Thousands of Titles, All for Free!</h2>
      <h3 class="text-lg md:text-xl font-bold text-gray-200 mb-5 tracking-wide">
        Unlike Your Crush, We Truly Care and We Show It Clear! <i class="fa-solid fa-heart-crack text-red-500"></i><i class="fa-solid fa-arrow-right mx-2 text-gray-500"></i><i class="fa-solid fa-heart text-pink-500"></i>
      </h3>
      <p class="text-gray-300 leading-relaxed text-lg max-w-3xl mx-auto">
