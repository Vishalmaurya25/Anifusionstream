<%- include('partials/header') %>

<!-- FONT AWESOME & GOOGLE FONTS CDN -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@900&family=Inter:wght@400;600;900&display=swap" rel="stylesheet">

<style>
  /* STRICT MOBILE LOCK TO PREVENT SHAKING */
  html, body { 
    background-color: #0b0e11; 
    color: #fff; 
    overflow-x: hidden; 
    width: 100%;
    max-width: 100vw;
    margin: 0;
    padding: 0;
    font-family: 'Inter', system-ui, sans-serif;
  }

  /* LOGO BACKGROUND - 100% VISIBILITY FIX */
  .bg-hero-logo {
    position: fixed; 
    top: 0; left: 0; width: 100vw; height: 100vh;
    z-index: 1; /* Body background ke upar */
    background-image: url('/images/logo.png'); 
    background-position: center; 
    background-repeat: no-repeat;
    background-size: 50%; 
    opacity: 0.2; 
    pointer-events: none; 
  }

  .bg-dark-overlay {
    position: fixed; 
    top: 0; left: 0; width: 100vw; height: 100vh;
    z-index: 2; /* Logo ke upar soft shadow */
    background: radial-gradient(circle at center, transparent 0%, #0b0e11 85%);
    pointer-events: none;
  }

  .section-glow {
    background: rgba(15, 20, 28, 0.5); border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 24px; padding: 40px 32px; margin-bottom: 32px;
    position: relative; backdrop-filter: blur(20px);
    box-shadow: 0 20px 50px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.1);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .section-glow:hover { border-color: rgba(59,130,246,0.3); box-shadow: 0 0 0 1px rgba(59,130,246,0.1), 0 10px 60px rgba(59,130,246,0.2); transform: translateY(-2px); }

  .brand-text { 
    font-family: 'Orbitron', sans-serif;
    background: linear-gradient(135deg, #60a5fa, #c084fc, #f472b6, #60a5fa); background-size: 200% auto;
    -webkit-background-clip: text; background-clip: text; color: transparent; 
    filter: drop-shadow(0 0 20px rgba(192, 132, 252, 0.6)); letter-spacing: 2px;
    animation: shineText 4s linear infinite;
  }
  @keyframes shineText { to { background-position: 200% center; } }

  .btn-glow { 
    background: linear-gradient(135deg, rgba(59,130,246,0.1), rgba(147,51,234,0.1)); backdrop-filter: blur(24px); 
    border: 1px solid rgba(147,51,234,0.4); border-radius: 999px; transition: all 0.3s ease; box-shadow: 0 0 20px rgba(147,51,234,0.2);
  }
  .btn-glow:hover { border-color: rgba(236,72,153,0.8); box-shadow: 0 0 40px rgba(236,72,153,0.4); transform: scale(1.05); }

  .tag-card { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); transition: 0.3s; display: inline-flex; align-items: center; gap: 8px; }
  .tag-card:hover { transform: translateY(-4px) scale(1.02); background: rgba(59,130,246,0.15); border-color: rgba(59,130,246,0.5); color: #fff; box-shadow: 0 5px 15px rgba(59,130,246,0.3); }

  .logo-wrap { width: 140px; height: 140px; margin: 0 auto 25px; padding: 16px; background: rgba(15,20,25,0.4); border: 1px solid rgba(59,130,246,0.5); border-radius: 35px; backdrop-filter: blur(10px); box-shadow: 0 0 40px rgba(59,130,246,0.4), inset 0 0 20px rgba(59,130,246,0.2); }
  .logo-wrap img { width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 0 20px rgba(96,165,250,0.9)); }

  /* FEATURE CARDS */
  .feature-card {
    background: rgba(15, 20, 28, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 20px;
    padding: 24px;
    backdrop-filter: blur(16px);
    transition: all 0.3s ease;
    height: 100%;
  }
  .feature-card:hover {
    background: rgba(59, 130, 246, 0.1);
    border-color: rgba(59, 130, 246, 0.4);
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.4);
  }
  .feature-icon {
    width: 48px; height: 48px;
    background: linear-gradient(135deg, rgba(59,130,246,0.2), rgba(147,51,234,0.2));
    border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    font-size: 20px; color: #60a5fa; margin-bottom: 16px;
    border: 1px solid rgba(59,130,246,0.3);
  }

  .share-box { background: linear-gradient(135deg, rgba(15, 23, 42, 0.7), rgba(30, 27, 75, 0.7)); border: 1px solid rgba(96,165,250,0.3); border-radius: 24px; padding: 32px; backdrop-filter: blur(24px); box-shadow: 0 20px 50px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.1); position: relative; overflow: hidden; }
  .share-title { background: linear-gradient(90deg, #60a5fa, #a78bfa, #f472b6); -webkit-background-clip: text; background-clip: text; color: transparent; font-family: 'Orbitron', sans-serif; }
  .share-btn { width: 56px; height: 56px; border-radius: 18px; display: flex; align-items: center; justify-content: center; font-size: 24px; color: #fff; transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); border: 1px solid rgba(255,255,255,0.1); cursor: pointer; box-shadow: 0 4px 15px rgba(0,0,0,0.3); }
  .share-btn:hover { transform: translateY(-5px) scale(1.15); box-shadow: 0 12px 25px rgba(0,0,0,0.5); border-color: rgba(255,255,255,0.3); }
  
  .btn-tg { background: linear-gradient(135deg, #0088cc, #00aaff); } .btn-wa { background: linear-gradient(135deg, #25D366, #1DA851); } .btn-x { background: linear-gradient(135deg, #14171a, #000000); } .btn-rd { background: linear-gradient(135deg, #FF4500, #FF6314); } .btn-share { background: linear-gradient(135deg, #6366f1, #8b5cf6); }

  /* 📱 MOBILE RESPONSIVE FIXES 📱 */
  @media (max-width: 640px) {
    .bg-hero-logo { background-size: 80%; }
    .section-glow { padding: 24px 16px; border-radius: 16px; }
    .share-box { padding: 24px 16px; border-radius: 16px; }
    .logo-wrap { width: 100px; height: 100px; padding: 12px; margin-bottom: 20px; border-radius: 24px; }
    .brand-text { font-size: 2rem !important; line-height: 1.2; letter-spacing: 1px; word-wrap: break-word; overflow-wrap: break-word; } 
    .share-btn { width: 45px; height: 45px; font-size: 18px; border-radius: 12px; }
  }
</style>

<div class="bg-hero-logo"></div>
<div class="bg-dark-overlay"></div>

<div class="relative z-10 min-h-screen px-4 py-12 flex flex-col justify-center w-full overflow-hidden">
