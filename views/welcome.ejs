<%- include('partials/header') %>

<!-- FONT AWESOME & GOOGLE FONTS CDN -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;900&family=Inter:wght@400;600;800;900&display=swap" rel="stylesheet">

<style>

  /* STRICT MOBILE LOCK TO PREVENT SHAKING */
  html, body { 
    background-color: #05070a; 
    color: #fff; 
    overflow-x: hidden !important; 
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0;
    font-family: 'Inter', system-ui, sans-serif;
    position: relative;
  }

  /* LOGO BACKGROUND - 100% VISIBILITY FIX */
  .bg-hero-logo {
    position: fixed; 
    top: 0; left: 0; 
    width: 100%; height: 100vh;
    z-index: 1;
    background-image: url('/images/logo.png'); 
    background-position: center; 
    background-repeat: no-repeat;
    background-size: 50%; 
    opacity: 0.15; 
    pointer-events: none; 
    animation: slowPulse 8s infinite alternate;
  }

  .jp-watermark {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 25vw;
    font-weight: 900;
    color: rgba(255, 255, 255, 0.02);
    z-index: 0;
    pointer-events: none;
    white-space: nowrap;
    user-select: none;
    letter-spacing: 0.1em;
  }

  @keyframes slowPulse {
    0% { transform: scale(1); opacity: 0.1; }
    100% { transform: scale(1.05); opacity: 0.2; }
  }

  .bg-dark-overlay {
    position: fixed; 
    top: 0; left: 0; width: 100%; height: 100vh;
    z-index: 2;
    background: radial-gradient(circle at center, transparent 0%, #05070a 85%);
    pointer-events: none;
  }

  /* PREMIUM GLOW SECTIONS */
  .section-glow {
    background: linear-gradient(145deg, rgba(15, 20, 28, 0.7), rgba(10, 14, 20, 0.9));
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 24px; 
    padding: 40px 32px; 
    margin-bottom: 32px;
    position: relative; 
    backdrop-filter: blur(20px);
    box-shadow: 0 20px 50px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.1);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 10;
  }
  .section-glow:hover { 
    border-color: rgba(34, 211, 238, 0.4); 
    box-shadow: 0 0 0 1px rgba(34, 211, 238, 0.1), 0 15px 60px rgba(34, 211, 238, 0.15); 
    transform: translateY(-2px); 
  }

  /* TYPOGRAPHY */
  .brand-text { 
    font-family: 'Orbitron', sans-serif;
    background: linear-gradient(135deg, #22d3ee, #3b82f6, #a855f7, #ec4899); 
    background-size: 300% auto;
    -webkit-background-clip: text; 
    background-clip: text; 
    color: transparent; 
    filter: drop-shadow(0 0 15px rgba(168, 85, 247, 0.4)); 
    letter-spacing: 2px;
    animation: shineText 5s linear infinite;
  }
  @keyframes shineText { to { background-position: 300% center; } }

  /* ENTER BUTTON - ANIMATED PULSE */
  .btn-glow { 
    position: relative;
    background: linear-gradient(135deg, rgba(59,130,246,0.15), rgba(168,85,247,0.15)); 
    backdrop-filter: blur(24px); 
    border: 1px solid rgba(34, 211, 238, 0.5); 
    border-radius: 999px; 
    transition: all 0.3s ease; 
    box-shadow: 0 0 20px rgba(34, 211, 238, 0.3), inset 0 0 15px rgba(59, 130, 246, 0.2);
    overflow: hidden;
  }
  .btn-glow::before {
    content: '';
    position: absolute;
    top: -50%; left: -50%; width: 200%; height: 200%;
    background: conic-gradient(transparent, rgba(34, 211, 238, 0.5), transparent 30%);
    animation: rotateBorder 3s linear infinite;
    z-index: -1;
  }
  @keyframes rotateBorder { 100% { transform: rotate(360deg); } }
  
  .btn-glow:hover { 
    border-color: rgba(236,72,153,0.8); 
    box-shadow: 0 0 40px rgba(236,72,153,0.6), inset 0 0 20px rgba(236,72,153,0.3); 
    transform: scale(1.05); 
    color: white;
  }

  .tag-card { 
    background: rgba(255,255,255,0.03); 
    border: 1px solid rgba(255,255,255,0.08); 
    transition: 0.3s; 
    display: inline-flex; 
    align-items: center; 
    gap: 8px; 
  }
  .tag-card:hover { 
    transform: translateY(-4px) scale(1.05); 
    background: rgba(34, 211, 238, 0.1); 
    border-color: rgba(34, 211, 238, 0.5); 
    color: #fff; 
    box-shadow: 0 5px 20px rgba(34, 211, 238, 0.3); 
  }

  .logo-wrap { 
    width: 150px; height: 150px; margin: 0 auto 25px; padding: 16px; 
    background: linear-gradient(135deg, rgba(15,20,25,0.6), rgba(5,7,10,0.8)); 
    border: 1px solid rgba(34, 211, 238, 0.4); 
    border-radius: 35px; 
    backdrop-filter: blur(15px); 
    box-shadow: 0 0 40px rgba(34, 211, 238, 0.3), inset 0 0 20px rgba(34, 211, 238, 0.2);
    position: relative;
    z-index: 10;
  }
  .logo-wrap img { width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 0 15px rgba(34, 211, 238, 0.6)); }

  /* FEATURE CARDS - CYBERPUNK STYLE */
  .feature-card {
    background: linear-gradient(180deg, rgba(20, 25, 35, 0.6) 0%, rgba(10, 15, 20, 0.8) 100%);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 20px;
    padding: 28px 24px;
    backdrop-filter: blur(16px);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    height: 100%;
    position: relative;
    overflow: hidden;
    z-index: 10;
  }
  .feature-card::after {
    content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 2px;
    background: linear-gradient(90deg, transparent, rgba(34, 211, 238, 0.5), transparent);
    opacity: 0; transition: opacity 0.3s;
  }
  .feature-card:hover::after { opacity: 1; }
  .feature-card:hover {
    background: linear-gradient(180deg, rgba(34, 211, 238, 0.1) 0%, rgba(10, 15, 20, 0.9) 100%);
    border-color: rgba(34, 211, 238, 0.4);
    transform: translateY(-8px);
    box-shadow: 0 15px 35px rgba(0,0,0,0.5), 0 0 20px rgba(34, 211, 238, 0.15);
  }
  
  .feature-icon {
    width: 54px; height: 54px;
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.15), rgba(168, 85, 247, 0.15));
    border-radius: 16px;
    display: flex; align-items: center; justify-content: center;
    font-size: 22px; color: #22d3ee; margin-bottom: 20px;
    border: 1px solid rgba(34, 211, 238, 0.3);
    box-shadow: inset 0 0 15px rgba(34, 211, 238, 0.1);
    animation: floatingIcon 4s ease-in-out infinite alternate;
  }
  @keyframes floatingIcon {
    0% { transform: translateY(0px); }
    100% { transform: translateY(-6px); }
  }

  /* SHARE SECTION */
  .share-box { background: linear-gradient(135deg, rgba(15, 23, 42, 0.8), rgba(30, 27, 75, 0.8)); border: 1px solid rgba(168, 85, 247, 0.3); border-radius: 24px; padding: 32px; backdrop-filter: blur(24px); box-shadow: 0 20px 50px rgba(0,0,0,0.6), inset 0 1px 0 rgba(255,255,255,0.1); position: relative; overflow: hidden; z-index: 10; }
  .share-title { background: linear-gradient(90deg, #22d3ee, #a855f7, #ec4899); -webkit-background-clip: text; background-clip: text; color: transparent; font-family: 'Orbitron', sans-serif; }
  .share-btn { width: 56px; height: 56px; border-radius: 18px; display: flex; align-items: center; justify-content: center; font-size: 24px; color: #fff; transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); border: 1px solid rgba(255,255,255,0.1); cursor: pointer; box-shadow: 0 4px 15px rgba(0,0,0,0.3); }
  .share-btn:hover { transform: translateY(-5px) scale(1.15); box-shadow: 0 12px 25px rgba(0,0,0,0.5); border-color: rgba(255,255,255,0.3); }
  
  .btn-tg { background: linear-gradient(135deg, #0088cc, #00aaff); } .btn-wa { background: linear-gradient(135deg, #25D366, #1DA851); } .btn-x { background: linear-gradient(135deg, #14171a, #000000); } .btn-rd { background: linear-gradient(135deg, #FF4500, #FF6314); } .btn-share { background: linear-gradient(135deg, #6366f1, #8b5cf6); }

  /* 📱 MOBILE RESPONSIVE FIXES 📱 */
  @media (max-width: 640px) {
    .bg-hero-logo { background-size: 80%; }
    .jp-watermark { font-size: 40vw; }
    .section-glow { padding: 24px 16px; border-radius: 16px; }
    .share-box { padding: 24px 12px; border-radius: 16px; }
    .logo-wrap { width: 110px; height: 110px; padding: 12px; margin-bottom: 20px; border-radius: 28px; }
    
    .brand-text { 
        font-size: clamp(1.8rem, 9vw, 2.5rem) !important; 
        line-height: 1.2; 
        letter-spacing: 0px; 
    } 
    
    .share-btn { width: 40px; height: 40px; font-size: 18px; border-radius: 12px; }
  }
</style>
</style>

