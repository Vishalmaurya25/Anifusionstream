      </p>
    </div>

    <!-- FEATURES GRID -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
      <div class="feature-card">
        <div class="feature-icon"><i class="fa-solid fa-book-journal-whills"></i></div>
        <h4 class="text-lg font-black text-white mb-2 uppercase tracking-wide">Extensive Library</h4>
        <p class="text-sm text-gray-400 leading-relaxed">
