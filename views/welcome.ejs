          <button class="share-btn btn-wa" data-platform="whatsapp" title="Share on WhatsApp"><i class="fa-brands fa-whatsapp"></i></button>
          <button class="share-btn btn-x" data-platform="twitter" title="Share on X / Twitter"><i class="fa-brands fa-x-twitter"></i></button>
          <button class="share-btn btn-rd" data-platform="reddit" title="Share on Reddit"><i class="fa-brands fa-reddit-alien"></i></button>
          <button class="share-btn btn-share" data-platform="native" title="More Options"><i class="fa-solid fa-link"></i></button>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
  const shareUrl = window.location.href; 
  const shareTitle = 'AniFusionStream';
  const shareText = ' Watch The Latest anime on AniFusionStream! Never miss an episode. Join me here:';

  document.querySelectorAll('.share-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const platform = btn.getAttribute('data-platform');
      let url = '';

      switch(platform) {
        case 'telegram':
          url = `https://t.me/share/url?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(shareText)}`;
          window.open(url, '_blank');
          break;
          
        case 'whatsapp':
          const waMessage = `${shareText}\n\n${shareUrl}`;
          url = `https://api.whatsapp.com/send?text=${encodeURIComponent(waMessage)}`;
          window.open(url, '_blank');
          break;
          
        case 'twitter':
          url = `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(shareUrl)}`;
          window.open(url, '_blank');
          break;
          
        case 'reddit':
          url = `https://reddit.com/submit?url=${encodeURIComponent(shareUrl)}&title=${encodeURIComponent(shareTitle)}`;
          window.open(url, '_blank');
          break;
          
        case 'native':
          if(navigator.share) {
            navigator.share({ 
              title: shareTitle, 
              text: shareText,
              url: shareUrl 
            }).catch(console.error);
          } else {
            navigator.clipboard.writeText(shareUrl);
            const originalIcon = btn.innerHTML;
            btn.innerHTML = '<i class="fa-solid fa-check"></i>';
            setTimeout(() => { btn.innerHTML = originalIcon; }, 2000);
            alert('Link Copied to Clipboard! Share it with your friends.');
          }
          break;
      }
    });
  });
</script>

