<%- include('partials/header') %>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    :root {
        --bg-deep: #0b0e11;
        --card-navy: #151b23;
        --inner-navy: #1c232d;
        --primary-blue: #3b82f6;
        --text-muted: #9ca3af;
    }

    .obsidian-card {
        background-color: var(--card-navy);
        border: 1px solid rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(10px);
        border-radius: 1.5rem;
        transition: all 0.3s ease;
        padding: 1.5rem;
        position: relative;
    }

    .obsidian-card:hover {
        border-color: rgba(59, 130, 246, 0.4);
        transform: translateY(-2px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }

    .ui-input {
        background-color: var(--inner-navy);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 0.75rem;
        color: #ffffff;
        padding: 0.75rem 1rem;
        outline: none;
        transition: all 0.2s;
        width: 100%;
    }

    .ui-input:focus {
        border-color: var(--primary-blue);
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
    }

    .btn-action {
        width: 40px;
        height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        transition: all 0.2s;
        background: #1c232d;
        border: 2px solid #3b82f6;
        color: #ffffff;
        cursor: pointer;
        font-size: 16px;
        font-weight: 900;
        position: relative;
        z-index: 10;
    }

    .btn-action:hover {
        transform: scale(1.1);
        background: #3b82f6;
        box-shadow: 0 0 20px rgba(59, 130, 246, 0.6);
    }

    .btn-delete {
        border-color: #ef4444!important;
        color: #ef4444!important;
    }

    .btn-delete:hover {
        background: #ef4444!important;
        color: #ffffff!important;
        box-shadow: 0 0 20px rgba(239, 68, 68, 0.6)!important;
    }

    .genre-badge {
        background: rgba(59, 130, 246, 0.15);
        border: 1px solid rgba(59, 130, 246, 0.3);
        color: #3b82f6;
        font-size: 9px;
        font-weight: 900;
        padding: 3px 8px;
        border-radius: 6px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: inline-block;
    }

    .sequence-badge {
        background: linear-gradient(135deg, #facc15 0%, #f59e0b 100%);
        color: #000;
        font-size: 11px;
        font-weight: 900;
        padding: 4px 10px;
        border-radius: 8px;
        text-transform: uppercase;
        letter-spacing: 1px;
        box-shadow: 0 0 15px rgba(250, 204, 21, 0.4);
    }

    .hidden { display: none!important; }

    /* Admin Login specific layouts */
    .auth-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 85vh;
        padding: 2rem 1.25rem;
    }

    .ui-card-login {
        background-color: var(--card-navy);
        border: 1px solid rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(25px);
        border-radius: 2.5rem;
        width: 100%;
        max-width: 450px;
        padding: 3.5rem 2.5rem;
        box-shadow: 0 30px 60px -12px rgba(0, 0, 0, 0.7);
    }

    .ui-label {
        font-size: 0.75rem;
        font-weight: 800;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.15em;
        margin-bottom: 0.7rem;
        display: block;
    }

    .ui-button {
        background-color: var(--primary-blue);
        color: #ffffff;
        font-weight: 900;
        padding: 1.2rem;
        border-radius: 1.25rem;
        width: 100%;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        text-transform: uppercase;
        letter-spacing: 0.2em;
        border: none;
        margin-top: 1rem;
        cursor: pointer;
    }

    .ui-button:hover {
        transform: translateY(-3px);
        filter: brightness(1.1);
        box-shadow: 0 15px 30px rgba(59, 130, 246, 0.4);
    }

    .admin-badge {
        background: rgba(59, 130, 246, 0.1);
        color: var(--primary-blue);
        padding: 6px 16px;
        border-radius: 99px;
        font-size: 10px;
        font-weight: 900;
        letter-spacing: 2px;
        text-transform: uppercase;
        border: 1px solid rgba(59, 130, 246, 0.2);
        display: inline-block;
    }

    .field-group { position: relative; }

    .toggle-btn {
        position: absolute;
        right: 1.2rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-muted);
        transition: color 0.2s;
        background: none;
        border: none;
        cursor: pointer;
    }

    .toggle-btn:hover { color: #fff; }

    .secondary-link {
        color: var(--text-muted);
        font-size: 0.8rem;
        font-weight: 700;
        transition: color 0.2s;
        text-decoration: none;
    }

    .secondary-link:hover { color: #fff; text-decoration: underline; }
</style>

<div class="auth-wrapper">
    <div class="text-center mb-10">
        <div class="mb-4">
            <span class="admin-badge">Secure Console</span>
        </div>
        <h1 class="text-4xl md:text-5xl font-black tracking-tighter uppercase">
            Admin <span class="text-blue-500">Portal</span>
        </h1>
        <p class="text-gray-500 mt-2 font-medium">Restricted Access • AniFusion Core</p>
    </div>

    <div class="ui-card-login">
        <%- include('partials/flash') %>

        <form action="/admin/login" method="POST">
            <div class="mb-6">
                <label class="ui-label">Administrator ID</label>
                <input type="text" name="username" class="ui-input" placeholder="Enter Username" required>
            </div>

            <div class="mb-8">
                <label class="ui-label">Access Key</label>
                <div class="field-group">
                    <input type="password" name="password" id="password" class="ui-input" placeholder="••••••••" required>
                    <button type="button" id="toggle-password" class="toggle-btn">
                        <svg id="eye-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                        </svg>
                    </button>
                </div>
            </div>

            <button type="submit" class="ui-button">
                Authorize Login
            </button>

            <div class="mt-10 flex flex-col items-center gap-3">
                <a href="/admin/forgot-password" class="secondary-link uppercase tracking-widest text-[10px]">Reset Admin Key?</a>
                <a href="/admin/register" class="text-[10px] text-blue-500/60 font-black uppercase tracking-widest hover:text-blue-400">System Registration</a>
            </div>
        </form>
    </div>
</div>

<script>
    const togglePassword = document.getElementById('toggle-password');
    const passwordInput = document.getElementById('password');
    const eyeIcon = document.getElementById('eye-icon');

    togglePassword.addEventListener('click', () => {
        const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
        passwordInput.setAttribute('type', type);

        if (type === 'text') {
            eyeIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.542-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.542 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />`;
        } else {
            eyeIcon.innerHTML = `
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            `;
        }
    });
</script>

<%- include('partials/footer') %>